# --- service ---------------------------------------------------------------
APP_NAME=inventory-service
HOST=127.0.0.1
PORT=8000

# --- OAuth 2.1 -------------------------------------------------------------
# In production ISSUER_URL points at your IdP and you delete /auth/token.
ISSUER_URL=http://localhost:8000
# RFC 8707 resource indicator. Tokens must carry this as their audience.
RESOURCE_SERVER_URL=http://localhost:8000
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=3600

# --- stdio mode (no HTTP, so no OAuth) -------------------------------------
MCP_STDIO_SUBJECT=local-user
MCP_STDIO_SCOPES=inventory:read analytics:run

# --- domain ----------------------------------------------------------------
SERVICE_LEVEL_Z=1.65
HOLDING_COST_RATE=0.22
ORDER_FIXED_COST=45.0
